# PostgreSQL connection string.
# Local dev example: postgres://postgres:postgres@localhost:5432/native
# Neon example:      postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Secret used to sign/verify auth sessions. Generate with:
#   bunx --bun random-32-bytes  # or: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Canonical base URL of the app (used by auth for callbacks/cookies).
# Local: http://localhost:3000
# Hosted: set for Production only. Preview deployments resolve their own origin
# from VERCEL_URL, since a fixed value would be wrong for a generated hostname.
BETTER_AUTH_URL=

# Vercel Preview only, and only once previews use their own database branch:
# set to 1 to apply migrations during a preview build.
# RUN_MIGRATIONS_ON_PREVIEW=1

# Realtime collaboration (Phase 4). Leave NEXT_PUBLIC_COLLAB_HOST empty to run
# solo (no realtime); the editor then behaves exactly as before.
# Local dev (partykit dev): 127.0.0.1:1999 — production: <project>.<user>.partykit.dev
NEXT_PUBLIC_COLLAB_HOST=

# Shared secret authenticating collaboration service calls:
#   - browser → app /api/collab/ticket (signing key for room tickets)
#   - party   → app /api/collab/document and /api/collab/save
# Must match the COLLAB_API_SECRET configured on the PartyKit deployment.
COLLAB_API_SECRET=

# PartyKit party → app callback target. Set in partykit.json (dev) and via
# `partykit env` (production); listed here for documentation.
# APP_URL=http://localhost:3000
